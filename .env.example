# 复制本文件为 .env 并填入真实值（.env 不入库）
#
# ┌─ 两套场景，别混用 ────────────────────────────────────────────────────────┐
# │ 本机开发（默认）：APP_ENV=dev   + EXECUTOR=local  → 模型代码在宿主进程里跑，│
# │   无隔离，只适合自己用。这正是本机当前的选择（为避免启用 VBS/虚拟化）。     │
# │ 生产部署（Linux 服务器 / docker compose）：                                │
# │   **必须** APP_ENV=production + EXECUTOR=docker + 显式 JWT_SECRET。        │
# │   用 docker-compose.yml 时这三项已经内置（compose 的 environment 优先级    │
# │   高于 env_file），你不需要在这里重复设置，但也因此**压不住**。            │
# └──────────────────────────────────────────────────────────────────────────┘

# ---- 智谱 API ----
# 申请：https://bigmodel.cn/usercenter/apikeys
ZHIPUAI_API_KEY=your-api-key-here
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
CHAT_MODEL=glm-5.2
# 需要走代理时填，例如 http://127.0.0.1:7897（httpx 会读它）
PROXY_URL=

# ---- Agent 循环（成本控制）----
# 工具调用轮数上限，用尽后摘掉 tools 再问一次强制收尾，避免无限循环烧 Token
AGENT_MAX_STEPS=8
# 连续多少次「同一处错误」就强制收尾，防撞墙
MAX_REPEAT_FAILURES=3
# 循环内历史消息的字符预算
HISTORY_MAX_CHARS=12000
# 无论如何完整保留的最后 N 轮
HISTORY_KEEP_TURNS=4

# ---- 执行器与运行环境 ----
# 本机开发：local（**无 OS 级隔离**，模型代码以当前用户权限运行、可读全盘、可出网）
# 生产部署：docker（唯一的真实隔离实现：--read-only / --network=none / 最小挂载 / 限额）
# 注意：APP_ENV != dev 时 local 会**拒绝构造**，应用直接不可用。
EXECUTOR=local
APP_ENV=dev

# ---- 多用户系统 ----
# JWT 签名密钥。dev 下不设会自动生成并持久化到 <STORAGE_DIR>/secret.key；
# **APP_ENV != dev 时必填，缺了服务直接拒绝启动**（随机密钥只落在容器文件系统里，
# 重建即丢，所有人被静默强制重登；多实例更是各签各的）。
# 生成：python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# 登录态有效期（小时），默认 7 天
JWT_EXPIRE_HOURS=168

# 首次启动引导创建的管理员（users 表为空时生效）
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
# 初始口令。**这里没有默认口令**：
#   - 留空 → 生成随机强口令，启动日志醒目横幅打印一次，并**强制首次登录改密**
#            （改密前除 /api/auth/me 与改密接口外一律 403）
#   - 填了 → 直接用它，但弱口令会让服务**拒绝启动**：要求 ≥12 位、至少 3 类字符
#            （大小写/数字/符号），且不在常见弱口令表里（admin123 会被明确拒绝）
ADMIN_PASSWORD=

# ---- 路径 ----
# 落盘根目录：SQLite（users/sessions/messages/datasets）、每用户工作区、secret.key
# 不设则默认 <仓库>/storage。用 docker-compose 时由 compose 按 APP_STORAGE_PATH 注入。
STORAGE_DIR=
# 用户库路径，特殊部署可单独指定；留空即默认 <STORAGE_DIR>/app.db
AUTH_DB_PATH=

# ---- 仅 docker-compose 使用（应用本身不读它）----
# 宿主机上存放数据的绝对路径。compose 会把它同时挂到容器的**同一路径**，
# 并据此设置 STORAGE_DIR。
#
# ⚠️ 为什么必须"两边路径一模一样"：DockerExecutor 传给 docker 的挂载参数是
#   **宿主路径**，而应用在容器里看到的是容器路径。两者不一致时，宿主 daemon
#   会挂一个**空目录**进沙箱 —— 模型看到空 /data，报一个和真实原因无关的错。
#   这也是本套 compose 只适用于 Linux 服务器的原因：Windows 上容器内不可能
#   出现 `D:\...` 这种盘符路径。
APP_STORAGE_PATH=/srv/data-analyst-agent/storage
